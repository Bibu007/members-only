<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Exclusive Club</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300..900&family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Oi&family=Pacifico&family=Press+Start+2P&family=Raleway:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Shrikhand&display=swap"
    rel="stylesheet"
  />
  <style>
    body {
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Oxygen,
        Ubuntu,
        Cantarell,
        "Open Sans",
        "Helvetica Neue",
        sans-serif;
    }
    header {
      display: flex;
      justify-content: space-between;
      margin: 10px 20px;
    }
    a {
      color: grey;
    }
    .message {
      margin: 10px 200px;
      padding: 20px;
      border: 1px solid black;
      border-radius: 10px;
    }
    .message p {
      font-size: 1.25rem;
    }
    .message h2 {
      color: red;
    }

    .message-details {
      display: flex;
      justify-content: space-between;
      padding: 10px 100px;
    }
    .date {
      color: gray;
    }
    .date p {
      font-size: 0.8rem;
    }
    form {
      display: grid;
      gap: 20px;
    }
    label {
      min-width: 100px;
    }
    input {
      min-width: 300px;
      border-radius: 10px;
      padding: 10px;
    }
    .form-item {
      width: 200px;
      display: flex;
      justify-content: space-between;
    }
    form button {
      width: 100px;
      font-size: 1.5rem;
      padding: 10px;
      border-radius: 10px;
      color: white;
      background-color: red;
    }
    nav {
      display: flex;
      gap: 40px;
      align-items: center;
    }
    .heading {
      display: flex;
      justify-content: space-between;
      padding: 10px 200px;
    }
    .create-post {
      background-color: inherit;
      font-weight: 800;
      color: rgb(52, 102, 238);
      font-size: larger;
      border: none;
    }
    .create-post:active {
      transform: translateY(2px);
    }
    .logo {
      font-family: "Pacifico";
      color: #ff4500;
      text-decoration: none;
    }
    nav a {
      font-size: 1.2rem;
      font-weight: 800;
      color: black;
      text-decoration: none;
    }
    h2:active {
      transform: translateY(2px);
    }
    .dialog-form {
      margin: 10px 10px;
    }
    .dialog-btn {
      font-size: 1rem;
      color: white;
      background-color: #ff4500;
      font-weight: 800;
      border: none;
    }
    .dialog-btn:active {
      transform: translateY(2px);
    }
    .dialog-btn-container {
      display: flex;
      justify-content: space-around;
    }
    textarea {
      border-radius: 10px;
    }
    dialog {
      border-radius: 10px;
    }
    .login-container {
      width: 100%;
      padding-top: 50px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .login-header {
      text-align: center;
    }
    .login-form {
      display: grid;
      margin: auto;
      place-content: center;
    }
  </style>
</head>
