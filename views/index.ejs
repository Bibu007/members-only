<!doctype html>
<html lang="en">
  <%- include ('./partials/head.ejs') %>
  <body>
    <%- include ('./partials/header.ejs') %>
    <div class="heading">
        <h2>POSTS</h2>
        <% if(user) { %>
        <button class="create-post">+ Create Post</button>
        <% } %>
    </div>
    <main>
        <div class="posts-container">
        <% if(posts.length > 0){ %>  
        <% posts.forEach(post =>  {%>
          <div class="message">
            <div class="info">
                <div class="title-container">
          <h3><%= post.title %></h3>
          <% if(user && user.admin) {%>
          <button class="delete" data-doc="<%= post.id %>">Delete</button>
          <% } %>
          </div>
          <p><%= post.post%></p>
          </div>
          <% if(user && user.member) {%>
          <div class="date">
            <p><%= post.username%> | <%= post.created_at.toLocaleString("en-GB", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false
}); %></p>
            
          </div>
          <% } %>
        </div>
        <%  }) %>
        <% } %>
    </div>
        <dialog class="create-dialog">
                <h3>Create post</h3>
                <form action="/create" method="POST" class="dialog-form">
                <label for="title">Title</label>
                <input id="title" class="post-title" name="title" type="text" required>
                <label for="content">Content: </label>
                <textarea id="content" class="content" name="content" rows="5" placeholder="What's on your mind?" required></textarea>
                <div class="dialog-btn-container">
                <button class="dialog-btn">Submit</button>
                <button type="button" class="cancel dialog-btn">Cancel</button>
                </div>
                </form>
        </dialog>

          <dialog class="join-dialog">
            <form action="/join" method="POST" class="dialog-form">
                <h3>Join the exclusive club</h3>
                <p> Want to know who posted what and when? Enter the secret key to join the club:</p>
                <input id="secret" class="secret" name="secret" type="password" required>
                <div class="dialog-btn-container">
                <button class="dialog-btn" >Join</button>
                <button type="button" class="cancel-join dialog-btn">Cancel</button>
                </div>
            </form>
        </dialog>
        
    </main>
  </body>
  <script>
        const createBtn = document.querySelector('.create-post');
        const dialog = document.querySelector('.create-dialog');
        //console.log("Hey");
        createBtn.addEventListener('click', (e) => {
            
                
                dialog.showModal();
                
                
        })
        const cancel = document.querySelector('.cancel');

                cancel.addEventListener('click', (e) => {
                    dialog.close();
                })
        
        const joinBtn = document.querySelector('.member');
        const joinDialog = document.querySelector('.join-dialog');
        //console.log("Hey");
        joinBtn.addEventListener('click', (e) => {
            
                
                joinDialog.showModal();
                
                
        })
        const cancelJoin = document.querySelector('.cancel-join');

                cancelJoin.addEventListener('click', (e) => {
                    joinDialog.close();
                })
                 
        const deleteBtn = document.querySelector('.posts-container');
        deleteBtn.addEventListener('click', (e) => {
            const endpoint = `/delete/${e.target.dataset.doc}`;
            console.log(`Endpoint: ${endpoint}`)
            window.location.href = `${endpoint}`;
        })
       
    </script>
</html>
